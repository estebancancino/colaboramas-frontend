# Copiar a .env y ajustar. Expo incrusta las variables EXPO_PUBLIC_* en el bundle,
# así que no pongas secretos aquí.

# URL base de la API, con el prefijo /api y sin barra final.
# Clúster: el dominio https del ingress. Local: http://<IP-de-tu-equipo>:8080/api
EXPO_PUBLIC_API_URL=https://colaboramas.example.cl/api
